{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/policy-candidates.schema.json",
  "title": "LAOS Policy Candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "run_id",
    "source_reflection_artifact_sha256",
    "candidates",
    "review_required",
    "applied"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "laos.policy-candidates.v1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "source_reflection_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "review_required": {"type": "boolean"},
    "applied": {"const": false}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "text",
        "normalized_text",
        "effect",
        "subject",
        "status",
        "duplicate_of",
        "conflicts_with"
      ],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "text": {"type": "string", "minLength": 1},
        "normalized_text": {"type": "string", "minLength": 1},
        "effect": {"enum": ["guidance", "require", "deny"]},
        "subject": {"type": "string", "minLength": 1},
        "status": {"enum": ["review_required", "duplicate", "conflicted"]},
        "duplicate_of": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{16}$"}
          ]
        },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
        }
      }
    }
  }
}
